//---------------------------------------------------------------------------
void __fastcall TForm1::Button1Click(TObject *Sender)
{
	for(int i = 0; i<ComponentCount;i++)
		if(Components[i]->Tag == 1)
		  if(((TButton*)Components[i])->Top>0)
			((TButton*)Components[i])->Top -= 20;
			//Button5->Top--; Top визначає відстань до верху форми. Чим Top < тим кнопка вище
}
//---------------------------------------------------------------------------
void __fastcall TForm1::Button3Click(TObject *Sender)
{
	for(int i = 0; i<ComponentCount;i++)
		if(Components[i]->Tag == 1)
			if	(((TButton*)Components[i])->Left+((TButton*)Components[i])->Width<ClientWidth)
			((TButton*)Components[i])->Left += 20;
}
//---------------------------------------------------------------------------
void __fastcall TForm1::Button2Click(TObject *Sender)
{
	for(int i = 0; i<ComponentCount;i++)
		if(Components[i]->Tag == 1)
		  if(((TButton*)Components[i])->Left>0)
			((TButton*)Components[i])->Left-= 20;
}
//---------------------------------------------------------------------------
void __fastcall TForm1::Button4Click(TObject *Sender)
{
	for(int i = 0; i<ComponentCount;i++)
		if(Components[i]->Tag == 1)
           if	(((TButton*)Components[i])->Top+((TButton*)Components[i])->Height<ClientHeight)
			((TButton*)Components[i])->Top += 20;
}
//---------------------------------------------------------------------------
void __fastcall TForm1::Button5Click(TObject *Sender)
{
	((TButton*)Sender)->Tag*=(-1);
}
